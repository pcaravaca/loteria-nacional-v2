# Backend
PORT=8080
JWT_SECRET=cambia-esto-en-produccion
SEED=true

# Base de datos: si DATABASE_URL (o DB_HOST) esta definida se usa PostgreSQL;
# si no, se crea/usa el archivo SQLite de DATABASE_PATH.
# DATABASE_URL=postgres://usuario:clave@100.89.167.67:5499/loteria_dev?sslmode=disable
# DB_HOST=100.89.167.67
# DB_PORT=5499
# DB_USER=loteria
# DB_PASSWORD=cambia-esto
# DB_NAME=loteria_dev
DATABASE_PATH=./data/loteria.db

# Frontend (desarrollo)
VITE_API_URL=http://localhost:8080
